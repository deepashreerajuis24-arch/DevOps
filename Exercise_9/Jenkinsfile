
pipeline {
    agent any

    environment {
        VENV = "${WORKSPACE}/.venv"
        DEPLOY_DIR = "${WORKSPACE}/python-app-deploy"
    }

    stages {
        stage('Build') {
            steps {
                echo 'Creating virtual environment and installing dependencies...'
                sh '''
                    python3 -m venv "$VENV"
                    "$VENV/bin/python" -m pip install --upgrade pip
                    "$VENV/bin/python" -m pip install -r requirements.txt
                '''
            }
        }

        stage('Test') {
            steps {
                echo 'Running unit tests...'
                sh '''
                    "$VENV/bin/python" -m unittest discover -s . -p "test_*.py"
                '''
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying application...'
                sh '''
                    mkdir -p "$DEPLOY_DIR"
                    cp app.py requirements.txt "$DEPLOY_DIR/"
                '''
            }
        }

        stage('Run Application') {
            steps {
                echo 'Starting the Flask application...'
                sh '''
                    if [ -f "$DEPLOY_DIR/app.pid" ]; then
                        old_pid=$(cat "$DEPLOY_DIR/app.pid")
                        kill "$old_pid" 2>/dev/null || true
                    fi

                    nohup "$VENV/bin/python" "$DEPLOY_DIR/app.py" \
                        > "$DEPLOY_DIR/app.log" 2>&1 &
                    echo $! > "$DEPLOY_DIR/app.pid"
                '''
            }
        }

        stage('Test Application') {
            steps {
                echo 'Testing the deployed application...'
                sh '''
                    "$VENV/bin/python" - <<'PY'
import time
import urllib.request

url = "http://127.0.0.1:5000/"

for attempt in range(10):
    try:
        with urllib.request.urlopen(url, timeout=2) as response:
            body = response.read().decode()
            assert response.status == 200
            assert body == "Hello, Jenkins Multi-Stage Pipeline!"
            print("Deployed application test passed!")
            break
    except Exception:
        if attempt == 9:
            raise
        time.sleep(1)
PY
                '''
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed. Check the console output.'
        }
    }
}
