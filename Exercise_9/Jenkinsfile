
pipeline {
    agent any

    environment {
        APP_DIR = "${WORKSPACE}/Exercise_9"
        VENV = "${WORKSPACE}/Exercise_9/.venv"
        DEPLOY_DIR = "${WORKSPACE}/Exercise_9/python-app-deploy"
    }

    stages {
        stage('Build') {
            steps {
                dir('Exercise_9') {
                    echo 'Installing dependencies...'
                    sh '''
                        python3 -m venv .venv
                        .venv/bin/python -m pip install -r requirements.txt
                    '''
                }
            }
        }

        stage('Test') {
            steps {
                dir('Exercise_9') {
                    echo 'Running unit tests...'
                    sh '''
                        .venv/bin/python -m unittest discover -s . -p "test_*.py"
                    '''
                }
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying application...'
                sh '''
                    mkdir -p "$DEPLOY_DIR"
                    cp "$APP_DIR/app.py" "$DEPLOY_DIR/"
                '''
            }
        }

        stage('Run Application') {
            steps {
                echo 'Starting Flask application...'
                sh '''
                    if [ -f "$DEPLOY_DIR/app.pid" ]; then
                        kill "$(cat "$DEPLOY_DIR/app.pid")" 2>/dev/null || true
                    fi

                    nohup "$VENV/bin/python" "$DEPLOY_DIR/app.py" \
                        > "$DEPLOY_DIR/app.log" 2>&1 &
                    echo $! > "$DEPLOY_DIR/app.pid"
                '''
            }
        }

        stage('Test Application') {
            steps {
                echo 'Testing the deployed application...'
                sh '''
                    "$VENV/bin/python" - <<'PY'
import time
import urllib.request

url = "http://127.0.0.1:5000/"

for attempt in range(10):
    try:
        with urllib.request.urlopen(url, timeout=2) as response:
            body = response.read().decode()
            assert response.status == 200
            assert body == "Hello, Jenkins Multi-Stage Pipeline!"
            print("Deployed application test passed!")
            break
    except Exception:
        if attempt == 9:
            raise
        time.sleep(1)
PY
                '''
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed. Check Console Output.'
        }
    }
}
